{
  "name": "hexa/hws-base-tools",
  "description": "HWS site policy and operations plugin for WordPress.",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require": {
    "php": ">=8.1"
  },
  "autoload": {
    "psr-4": {
      "HWS\\BaseTools\\": "src/"
    }
  },
  "scripts": {
    "test": [
      "@php tests/quick-start-litespeed-review-unit.php",
      "@php tests/bootstrap-fleet-seeder.php",
      "@php tests/litespeed-wordfence-policy-unit.php",
      "@php tests/review-quick-start-safety-unit.php",
      "@php tests/legacy-generic-library-unit.php",
      "@php tests/mail-authentication-unit.php",
      "@php tests/brand-templates-unit.php",
      "@php tests/shared-content-types-unit.php",
      "@php tests/team-member-directory-unit.php",
      "@php tests/reading-progress-unit.php",
      "@php tests/plugin-policy-unit.php",
      "@php tests/user-profile-2025-migration-unit.php",
      "@php tests/user-profile-gallery-details-unit.php",
      "@php tests/query-hook-compatibility-unit.php",
      "@php tests/query-hook-compatibility-ptt-drift.php",
      "@php tests/query-hook-inventory-static.php",
      "@php tests/run.php",
      "@php lib/hexa-wordpress-plugin-core/tests/package-integrity.php",
      "@php lib/hexa-wordpress-plugin-core/tests/core-package-registry.php",
      "@php lib/hexa-wordpress-plugin-core/tests/core-package-collision.php",
      "@php lib/hexa-wordpress-plugin-core/tests/core-package-auto-sync.php",
      "@php lib/hexa-wordpress-plugin-core/tests/core-package-fleet.php",
      "@php lib/hexa-wordpress-plugin-core/tests/acf-field-factory.php",
      "@php lib/hexa-wordpress-plugin-core/tests/data-normalization.php",
      "@php lib/hexa-wordpress-plugin-core/tests/getting-started-checklist-state.php",
      "@php lib/hexa-wordpress-plugin-core/tests/litespeed-cache.php",
      "@php lib/hexa-wordpress-plugin-core/tests/wordpress-operations.php",
      "@php lib/hexa-wordpress-plugin-core/tests/database-cleanup-state.php",
      "@php lib/hexa-wordpress-plugin-core/tests/getting-started-checklist-search.php",
      "@php lib/hexa-wordpress-plugin-core/tests/search-display-renderer.php",
      "@php lib/hexa-wordpress-plugin-core/tests/search-query-engine.php",
      "@php lib/hexa-wordpress-plugin-core/tests/site-structure-lazy-workspace.php",
      "@php lib/hexa-wordpress-plugin-core/tests/snippet-metadata-renderer.php",
      "@php lib/hexa-wordpress-plugin-core/tests/media-gallery-details.php",
      "@php lib/hexa-wordpress-plugin-core/tests/acf-gallery-details-module.php"
    ]
  },
  "config": {
    "sort-packages": true
  }
}
