{
  "name": "hexa/hws-base-tools",
  "description": "HWS site policy and operations plugin for WordPress.",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require": {
    "php": ">=8.1"
  },
  "autoload": {
    "psr-4": {
      "HWS\\BaseTools\\": "src/"
    }
  },
  "scripts": {
    "test": [
      "@php tests/mail-authentication-unit.php",
      "@php tests/brand-templates-unit.php",
      "@php tests/shared-content-types-unit.php",
      "@php tests/user-profile-2025-migration-unit.php",
      "@php tests/run.php",
      "@php lib/hexa-wordpress-plugin-core/tests/package-integrity.php",
      "@php lib/hexa-wordpress-plugin-core/tests/core-package-registry.php",
      "@php lib/hexa-wordpress-plugin-core/tests/core-package-collision.php",
      "@php lib/hexa-wordpress-plugin-core/tests/database-cleanup-state.php",
      "@php lib/hexa-wordpress-plugin-core/tests/getting-started-checklist-search.php",
      "@php lib/hexa-wordpress-plugin-core/tests/search-display-renderer.php",
      "@php lib/hexa-wordpress-plugin-core/tests/search-query-engine.php",
      "@php lib/hexa-wordpress-plugin-core/tests/site-structure-lazy-workspace.php",
      "@php lib/hexa-wordpress-plugin-core/tests/snippet-metadata-renderer.php"
    ]
  },
  "config": {
    "sort-packages": true
  }
}
